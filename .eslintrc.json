{
  "env": {
    "node": true,
    "es2021": true,
    "commonjs": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    /* --- Essential Base Rules --- */
    "indent": ["error", 2],           // Enforce 2-space indentation (Node.js standard)
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],    // Enforce the use of single quotes (' ')
    "semi": ["error", "always"],      // Require semicolons at the end of statements

    /* --- Node.js & Best Practices --- */
    "no-unused-vars": ["warn"],       // Warn when variables are declared but not used
    "no-console": "off",              // Allow console.log (common in backend development)
    "no-var": "error",                // Disallow 'var'; require 'let' or 'const' instead
    "prefer-const": "error",          // Require 'const' for variables that are never reassigned
    "eqeqeq": ["error", "always"],    // Enforce the use of === and !== for type safety

    /* --- File & Directory Management --- */
    "no-path-concat": "error",        // Disallow string concatenation for paths (use path.join instead)
    "handle-callback-err": "error"    // Require error handling in callbacks
  }
}
