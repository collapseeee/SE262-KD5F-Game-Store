<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD5F - Shopping Cart</title>
    <!-- Link Bootstrap -->
    <link rel="stylesheet" href="/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <!-- Link style.css -->
    <link rel="stylesheet" href="/styles/style.css" />
  </head>
  <body>
    <%-include('partials/navbar')%>
    <main class="container my-4">
      <h1>Your Shopping Cart</h1>
      <div class="row">
        <div class="items-container col-12 col-lg-8">
            <% games.forEach((game) => { %>
                <%- include('partials/cartItem',{game: game}) %>
            <% }); %>
        </div>
        <div class="col-12 col-lg-4">
            <div class="items-container">
                <div class="checkout-container rounded-4 mb-3 shadow p-4">
                    <% var sumPrice = 0; %>
                    <% var discount = 0; %>
                    <% games.forEach((game) => { %>
                        <% sumPrice += game.price; %>
                        <div class="d-flex justify-content-between align-items-center mb-3 mt-0">
                            <p class="text-start text-truncate flex-grow-1 m-0"><%- game.name -%></p>
                            <p class="text-end text-nowrap m-0">$<%- game.price -%></p>
                        </div>
                    <% }); %>
                    <hr class="hr m-0" />
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-0">
                        <% var totalVat = Math.ceil(sumPrice*7)/100; %>
                        <p class="text-start text-truncate flex-grow-1 m-0">VAT</p>
                        <p class="text-end text-nowrap m-0">$<%- totalVat -%></p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-0">
                        <p class="text-start text-truncate flex-grow-1 m-0" style="color: aquamarine;">Discount</p>
                        <p class="text-end text-nowrap m-0" style="color: aquamarine;">$<%- discount -%></p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-0">
                        <% var finalPrice = sumPrice-discount; %>
                        <h4 class="text-start text-truncate flex-grow-1 m-0"">Total</p>
                        <h4 class="text-end text-nowrap m-0">$<%- finalPrice -%></p>
                    </div>
                    <div class="d-flex justify-content-center">
                        <button class="btn rounded-pill py-2 shadow-sm fw-bold fs-4 w-75 mt-2" id="checkout">Checkout</button>
                    </div>
                </div>
            </div>
            <div class="items-container">
                <div class="checkout-container rounded-4 mb-3 shadow p-4">
                    <p class="text-start fw-bold m-1">KaiDao Coupon</p>
                    <div class="input-group shadow-sm rounded-pill">
                        <input type="text" 
                                class="form-control border-0 ps-4" 
                                placeholder="Promo Code" 
                                style="height: 50px; border-radius: 50px 0 0 50px;">
                        
                        <button class="btn btn-success px-4 fw-bold" 
                                type="button" 
                                id="button-redeem">
                            REDEEM
                        </button>
                    </div>
                </div>
            </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer')%>
    <script src="/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

<style>
  .checkout-container {
    background-color: #8b00f5;
  }
  #checkout {
    background-color: #B7EF00;
  }
  #button-redeem {
    background-color: #B7EF00;
    color: black;
    border-radius: 0 50px 50px 0;
  }
</style>