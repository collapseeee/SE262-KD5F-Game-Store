<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD5F - Shopping Cart</title>
    <!-- Link Bootstrap -->
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/bootstrap-icons/font/bootstrap-icons.min.css" />
    <!-- Link style.css -->
    <link rel="stylesheet" href="/styles/style.css" />
  </head>
  <body>
    <%-include('partials/popup/payment')%>
    <%-include('partials/popup/paymentSuccess')%>
    <%-include('partials/navbar')%>
    <main class="container my-4">
      <h1><span id="cart-header-span">Your Shopping Cart</span> <span id="checkout-header-span" style="display: none;"> > Checkout</span></h1>
      <a href="/" class="back-to-home"><p>< Back to Home</p></a>
      <div class="row">
        <div class="items-container col-12 col-lg-8">
            <% games.forEach((game) => { %>
                <%- include('partials/cartItem',{game: game}) %>
            <% }); %>
        </div>
        <div class="col-12 col-lg-4">
            <div class="items-container">
                <div class="checkout-container rounded-4 mb-3 shadow p-4" id="payment-container" style="display: none;">
                    <h4>Payment Method</h4>
                    <div class="form-check">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="payment-method"
                                id="payment-qr">
                            <label class="form-check-label" for="payment-qr">
                                QR Promptpay
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="payment-method"
                                id="payment-truemoney">
                            <label class="form-check-label" for="payment-truemoney">
                                Truemoney
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="payment-method"
                                id="payment-banking" disabled>
                            <label class="form-check-label" for="payment-banking">
                                Mobile Banking
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="payment-method"
                                id="payment-mastercard" disabled>
                            <label class="form-check-label" for="payment-mastercard">
                                Mastercard
                            </label>
                        </div>
                    </div>
                </div>
                <div class="checkout-container rounded-4 mb-3 shadow p-4">
                    <% var sumPrice = 0; %>
                    <% var discount = 0; %>
                    <% games.forEach((game) => { %>
                        <% sumPrice += game.price; %>
                        <div class="d-flex justify-content-between align-items-center mb-3 mt-0">
                            <p class="text-start text-truncate flex-grow-1 m-0"><%- game.name -%></p>
                            <p class="text-end text-nowrap m-0">$<%- game.price -%></p>
                        </div>
                    <% }); %>
                    <hr class="hr m-0" />
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-0">
                        <% var totalVat = Math.ceil(sumPrice*7)/100; %>
                        <p class="text-start text-truncate flex-grow-1 m-0">VAT</p>
                        <p class="text-end text-nowrap m-0">$<%- totalVat -%></p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-0">
                        <p class="text-start text-truncate flex-grow-1 m-0" style="color: aquamarine;">Discount <span id="discount-rate-msg"></span></p>
                        <p class="text-end text-nowrap m-0" style="color: aquamarine;">$<span id="discount-msg"><%- discount -%></span></p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-0">
                        <% var finalPrice = sumPrice+totalVat-discount; %>
                        <h4 class="text-start text-truncate flex-grow-1 m-0"">Total</p>
                        <h4 class="text-end text-nowrap m-0">$<span id="final-price-msg"><%- finalPrice -%></span></p>
                    </div>
                    <div class="d-flex justify-content-center">
                        <button class="btn rounded-pill py-2 shadow-sm fw-bold fs-4 w-75 mt-2" id="button-checkout">Checkout</button>
                    </div>
                </div>
            </div>
            <div class="items-container">
                <div class="checkout-container rounded-4 mb-3 shadow p-4" id="coupon-container">
                    <p class="text-start fw-bold m-1">KaiDao Coupon</p>
                    <div class="input-group shadow-sm rounded-pill">
                        <input type="text" 
                                class="form-control border-0 ps-4" 
                                placeholder="Promo Code" 
                                style="height: 50px; border-radius: 50px 0 0 50px;"
                                id="promo-input">
                        
                        <button class="btn btn-success px-4 fw-bold" 
                                type="button" 
                                id="button-redeem">
                            REDEEM
                        </button>
                    </div>
                </div>
            </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer')%>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Checkout popups logics
        const cartHeaderSpan = document.getElementById('cart-header-span');
        const checkoutHeaderSpan = document.getElementById('checkout-header-span');
        const checkoutBtn = document.getElementById("button-checkout")
        const couponContainer = document.getElementById('coupon-container');

        const paymentContainer = document.getElementById("payment-container")
        const paymentPopup = document.getElementById('payment-popup-container');
        const paymentPopupOverlay = document.getElementById('payment-popup-overlay');
        const paymentProceedBtn = document.getElementById('payment-popup-button-proceed');
        const paymentCancelBtn = document.getElementById('payment-popup-button-cancel');

        const successPopup = document.getElementById('success-popup-container');
        const successPopupOverlay = document.getElementById('success-popup-overlay');
        const successProceedBtn = document.getElementById('success-popup-button-proceed');

        checkoutBtn.addEventListener('click', (e) => {
            if (paymentContainer.style.display !== 'block') { // First click, show payment methods.
                cartHeaderSpan.style.color = '#fefefe7e'
                checkoutHeaderSpan.style.display = 'block';
                paymentContainer.style.display = 'block';
                couponContainer.style.display = 'none'
            } else { // Second click, continue payment.
                const selectedMethod = document.querySelector('input[name="payment-method"]:checked');

                if(!selectedMethod) {
                    alert("Please select a payment method before proceeding!");
                    return;
                }
                
                const paymentTitle = document.getElementById('payment-popup-h1');
                const paymentMsg = document.getElementById('payment-popup-p');
                const paymentImg = document.getElementById('payment-popup-img');
                const totalPrice = document.getElementById('final-price-msg').innerHTML;

                if (selectedMethod.id == 'payment-qr') {
                    paymentTitle.innerHTML = "Scan QR to pay";
                    paymentMsg.innerHTML = `Your selected payment method is QR Payment. <br> Total amount: $${totalPrice}`;
                    paymentImg.src = "/assets/qr-payment.jpg";
                } else if (selectedMethod.id == 'payment-truemoney') {
                    paymentTitle.innerHTML = "Scan Truemoney to pay";
                    paymentMsg.innerHTML = `Your selected payment method is QR Payment. <br> Total amount: $${totalPrice}`;
                    paymentImg.src = "/assets/truemoney-payment.jpg";
                }

                paymentPopup.style.display = 'block';
                paymentPopupOverlay.style.display = 'block';
            }
        });
        
        paymentProceedBtn.addEventListener('click', (e) => {
            paymentPopup.style.display = 'none';
            paymentPopupOverlay.style.display = 'none';

            successPopup.style.display = 'block';
            successPopupOverlay.style.display = 'block';
        });

        paymentCancelBtn.addEventListener('click', (e) => {
            paymentPopup.style.display = 'none';
            paymentPopupOverlay.style.display = 'none';
        });

        successProceedBtn.addEventListener('click', (e) => {
            successPopup.style.display = 'none';
            successPopupOverlay.style.display = 'none';
            window.location.href = '/';
            // Handle removing data from cart later on.
        });

        // Promo code logic
        const redeemBtn = document.getElementById('button-redeem');
        const promoInput = document.getElementById('promo-input');
        const finalPriceSpan = document.getElementById('final-price-msg');
        const discountSpan = document.getElementById('discount-msg');
        const discountRateSpan = document.getElementById('discount-rate-msg');
        const totalAmountPopup = document.getElementById('payment-popup-price-p');
        let currentTotal = finalPriceSpan.innerHTML;
        let discountApplied = false;

        redeemBtn.addEventListener('click', () => {
            const code = promoInput.value.trim().toLowerCase();

            if (code === "pisetkaidao".toLowerCase()) {
                if (!discountApplied) {
                    const discountAmount = currentTotal * 0.05;
                    currentTotal = currentTotal - discountAmount;
                    
                    // Update UI
                    discountSpan.innerHTML = discountAmount.toFixed(2);
                    finalPriceSpan.innerText = currentTotal.toFixed(2);
                    discountRateSpan.innerHTML = "(5%)";
                    totalAmountPopup.innerHTML = currentTotal.toFixed(2);
                    
                    discountApplied = true;
                    promoInput.disabled = true;
                    redeemBtn.disabled = true;
                }
            } else {
                alert("Invalid Promo Code.");
            }
        });
    </script>
  </body>
</html>

<style>
    .checkout-container {
        background-color: #8b00f5;
    }
    #button-checkout{
        background-color: #B7EF00;
    }
    #button-redeem {
        background-color: #B7EF00;
        color: black;
        border-radius: 0 50px 50px 0;
    }
</style>