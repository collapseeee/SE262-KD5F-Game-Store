<nav aria-label="...">
  <ul class="pagination justify-content-center round-circle my-4">
    <li class="page-item"><a class="page-link" href="#" onclick="displayPage(1)"><<</a></li>
    <li class="page-item"><a class="page-link" href="#" ><</a></li>
    <% const numberOfPages = Math.ceil(games.length/12); %>
    <li class="page-item active"><a class="page-link" href="#">1</a></li>
    <% if (numberOfPages<=7) { %>
        <% for(let i=2; i<=numberOfPages; i++) { %>
            <li class="page-item"><a class="page-link" href="#"><%= i %></a></li>
        <% }; %>
    <% }; %>
    <% if (numberOfPages>7) { %>
        <% for(let i=2; i<=numberOfPages; i++) { %>
            <li class="page-item"><a class="page-link" href="#"><%= i %></a></li>
        <% }; %>
    <% }; %>
    <li class="page-item"><a class="page-link" href="#">></a></li>
    <li class="page-item"><a class="page-link" href="#">>></a></li>
  </ul> 
</nav>
<p class="text-center my-0 p-0">Displaying <span id="per-page-count">0</span> games out of <%= games.length %> results.</p>
<script>
    const perPageCountSpan = document.getElementById('per-page-count');
    const perPageCount = document.getElementsByClassName('card').length;
    perPageCountSpan.innerHTML = perPageCount;
</script>
<style>
    .pagination.round-circle .page-item {
        margin: 0 5px;
    }

    .pagination.round-circle .page-link {
        font-size: large;
        width: 60px;
        height: 60px;
        line-height: 60px;
        padding: 0;
        text-align: center;
        border-radius: 50%;

        background-color: #5C3B75;
        color: #fefefe;
        border: 1px solid #8122C9;
        transition: all 0.3s ease;
    }

    .pagination.round-circle .page-item.active .page-link {
        background-color: #8B00F5; 
        color: #fefefe; 
        border-color: #B7EF00;
    }

    .pagination.round-circle .page-link:hover {
        background-color: #B7EF00; /* Primary Purple */
        color: #000000;
        border-color: #8122C9;
    }
</style>