                aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#autoplay-carousel" data-bs-slide-to="1"
                aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#autoplay-carousel" data-bs-slide-to="2"
                aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#autoplay-carousel" data-bs-slide-to="3"
                aria-label="Slide 4"></button>
            <button type="button" data-bs-target="#autoplay-carousel" data-bs-slide-to="4"
                aria-label="Slide 5"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="./assets/landing/Landing-Page-Carousel-1.png" class="d-block w-100 rounded-4" alt="KAIDAO Festival Discount up to 0%!" />
            </div>
            <div class="carousel-item">
                <img src="./assets/landing/Landing-Page-Carousel-2.png" class="d-block w-100 rounded-4" alt="Redeem 'Pisetkaidao' code to get 5% discount." />
            </div>
            <div class="carousel-item">
                <img src="./assets/landing/Landing-Page-Carousel-3.png" class="d-block w-100 rounded-4" alt="New arrival: Resident Evil Requim with $69.99" />
            </div>
            <div class="carousel-item">
                <img src="./assets/landing/Landing-Page-Carousel-4.png" class="d-block w-100 rounded-4" alt="New arrival: Monster Hunter Stories 3: Twisted Reflection with $69.99" />
            </div>
            <div class="carousel-item">
                <img src="./assets/landing/Landing-Page-Carousel-5.png" class="d-block w-100 rounded-4" alt="New arrival: The Walking Jord: Requim with $67.99" />
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#autoplay-carousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#autoplay-carousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
