<div
  data-game-id="<%=game.product_id%>"
  class="card col-lg-3 col-md-4 col-12 rounded-3 pt-0 px-0 pb-3 my-2"
>
  <img class="rounded-top-3 w-100 poster" src="<%=game.poster_url%>" alt="" />
  <div>
    <p class="game-category"><%=game.category%></p>
    <p class="game-name"><%=game.name%></p>
    <p class="game-price mt-auto">$ <%=game.price%></p>
    <form class="button-container d-flex w-100 mt-auto">
      <button id="wishlist" data-game-id="<%=game.product_id%>">
        <svg
          class="bi px-auto card-svg pe-none"
          width="32"
          height="32"
          fill="currentColor"
        >
          <use xlink:href="bootstrap-icons.svg#heart" />
        </svg>
      </button>
      <button id="add-to-cart" data-game-id="<%=game.product_id%>">
        <svg
          class="bi px-auto card-svg pe-none"
          width="32"
          height="32"
          fill="currentColor"
        >
          <use xlink:href="bootstrap-icons.svg#cart-plus" />
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  .card-svg {
    color: #5c3b75;
  }

  .card {
    height: 430px;
    width: 256px;
    background-color: #5c3b75;
    color: #fefefe;
    box-shadow: 5px 5px 5px rgb(0 0 0 / 15%);
    cursor: pointer;
  }

  #wishlist,
  #add-to-cart {
    background-color: #b7ef00;
    height: 48px;
    border: none;
  }

  #wishlist > img,
  #add-to-cart > img {
    width: 32px;
  }

  #wishlist {
    width: 48px;
    border-radius: 50%;
    margin: 0 0 0 15px;
  }

  #add-to-cart {
    width: 70%;
    border-radius: 50px;
    margin: 0 15px 0 5px;
  }

  .game-category {
    margin: 5px 25px 0 25px;
    color: #cfcfcf;
  }

  .game-name {
    line-height: 1.05;
    height: 100%;
    max-height: 48px;
    margin: 0 25px;
    font-size: 1.5em;
    text-align: left;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .game-price {
    margin: 0;
    text-align: right;
    font-size: 1.5em;
    padding-right: 25px;
  }

  .poster {
    object-fit: cover;
    object-position: 0 0;
    max-width: 100%;
    max-height: 256px;
  }
</style>
