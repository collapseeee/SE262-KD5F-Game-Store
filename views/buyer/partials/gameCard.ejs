<div class="card col-lg-3 col-md-4 col-12 rounded-3 pt-0 px-0 pb-3 my-2 scroll-reveal"
  data-game-id="<%=game.product_id%>" style="--reveal-delay: <%= (typeof index !== 'undefined' ? index * 100 : 0) %>ms">

  <img class="rounded-top-3 w-100 poster" src="<%=game.poster_url%>" alt="" />
  <div>
    <p class="game-category"><%=game.category%></p>
    <p class="game-name"><%=game.name%></p>
    <p class="game-price mt-auto">$ <%=game.price%></p>
    <form class="button-container d-flex w-100 mt-auto">
      <button id="wishlist" data-game-id="<%=game.product_id%>">
          <% if (wishlists.includes(game.product_id)) {%>
            <i class="bi-heart-fill fs-2"></i>
          <%} else {%>
            <i class="bi-heart fs-2"></i>
          <%}%>
      </button>
      <button id="add-to-cart" data-game-id="<%=game.product_id%>">
        <i class="bi-cart-plus fs-2"></i>
      </button>
    </form>
  </div>
</div>
<style>
  button >[class*="bi-"] {
    color: #5c3b75;
    pointer-events: none;
  }

  .card {
    height: 430px;
    width: 256px;
    background-color: #5c3b75;
    color: #fefefe;
    box-shadow: 5px 5px 5px rgb(0 0 0 / 15%);
    overflow: hidden;
    cursor: pointer;
  }
  #wishlist,
  #add-to-cart {
    background-color: #b7ef00;
    height: 48px;
    border: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  #wishlist:hover,
  #add-to-cart:hover {
    background-color: #c8ff2a;
    transform: scale(1.05);
  }

  .card-svg {
    transition: color 0.2s ease;
  }

  #wishlist:hover .card-svg,
  #add-to-cart:hover .card-svg {
    color: #2f2b33;
  }

  #wishlist > img,
  #add-to-cart > img {
    width: 32px;
  }

  #wishlist {
    width: 48px;
    border-radius: 50%;
    margin: 0 0 0 15px;
  }

  #add-to-cart {
    width: 70%;
    border-radius: 50px;
    margin: 0 15px 0 5px;
  }

  .game-category {
    margin: 5px 25px 0 25px;
    color: #cfcfcf;
  }

  .game-name {
    line-height: 1.05;
    height: 100%;
    max-height: 48px;
    margin: 0 25px;
    font-size: 1.5em;
    text-align: left;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .game-price {
    margin: 0;
    text-align: right;
    font-size: 1.5em;
    padding-right: 25px;
  }

  .poster {
    object-fit: cover;
    object-position: 0 0;
    max-width: 100%;
    max-height: 256px;
    height: 100%;
  }
</style>
