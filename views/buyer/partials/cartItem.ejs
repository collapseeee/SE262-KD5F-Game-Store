<div class="container cart-container rounded-4 mb-3">
  <div class="p-4 row shadow">
    <div class="col-4 overflow-hidden">
      <img class="game-poster w-100 rounded-4" src="https://placehold.co/512x256" alt="<%=game.name%>" style="
      height: 256px; 
      object-fit: cover; 
      object-position: center;" />
    </div>
    <div class="col-8 d-flex flex-column my-lg-0 my-sm-2">
      <div class="row">
        <div class="col-12 col-sm-6">
          <p class="fs-3 fw-medium text-truncate">
            <%=game.name%>
          </p>
          <p class="fs-4">
            <% game.categories.forEach((category)=> { %>
              <%=category%>
                <%})%>
          </p>
        </div>
        <div class="col-12 col-sm-6">
          <p class="fs-3 text-end">$ <%=game.price%>
          </p>
        </div>
      </div>
      <div class="d-flex justify-content-between align-items-center mt-auto">
        <p class="opacity-75 mb-0 text-truncate">
          Added: 
          <% if (game.wishlisted_date) { %> 
            <!--For wishlist page.-->
            <%=game.wishlisted_date%>
          <% } else { %>
            <!--For cart page.-->
            <%=game.added_date %>
          <% } %>
        </p>
        <!-- Add DELETE method later.-->
        <a class="link-danger link-underline-danger">Remove</a>
      </div>
    </div>
  </div>
</div>

<style>
  .cart-container {
    background-color: #8b00f5;
  }
</style>