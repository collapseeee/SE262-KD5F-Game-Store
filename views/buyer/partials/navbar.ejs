<script type="text/javascript" src="/dist/jquery.min.js"></script>
<nav class="navbar navbar-expand-lg bg-custom my-3">
  <div class="container align-items-start justify-content-center">
    <div class="navbar-brand rounded-5 d-flex px-2">
      <a href="/">
        <img class="rounded-circle" id="brand-icon" src="/assets/KD5FIcon.png" alt="KD5F icon" />
      </a>
      <div class="category-container px-3">
          <!-- Brand Category Dropdown -->
          <div class="nav-item dropdown">
            <a class="dropdown-toggle-custom text-decoration-none link-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <svg class="bi" width="32" height="32" fill="currentColor">
                <use xlink:href="bootstrap-icons.svg#tags-fill" />
              </svg>
              <p>Category</p>
            </a>
            <!-- Dropdown menu -->
            <ul class="dropdown-menu">
              <% categories.forEach(category=> { %>
                <li><a class="dropdown-item" href="#">
                    <%=category.name%>
                  </a></li>

                <%});%>
            </ul>
          </div>
      </div>
    </div>
    <ul class="navbar-nav flex-grow-1">
      <!-- Search bar -->
      <li class="nav-item search-bar mx-4 mt-lg-0 mt-sm-2 mt-md-2 flex-grow-1 order-1 order-sm-4 order-md-4 order-lg-1">
        <form class="d-flex h-100 w-100 align-items-center" action="/search" method="post">
          <!-- Search Button -->
          <button class="rounded-start-5" id="search-button" type="submit">
            <svg class="bi px-2" width="32" height="32" fill="currentColor">
              <use xlink:href="bootstrap-icons.svg#search" />
            </svg>
          </button>

          <!-- Search Input -->
          <input class="d-flex flex-grow-1 h-100 px-2" type="text" name="gameName" id="search-input" placeholder="Search here"/>

          <!-- Category Dropdown -->
          <select name="category" id="category-selection" multiple="multiple">
            <% categories.forEach(category => { %>
              <option value="<%=category.category_id%>"><%=category.name%></option>
            <%});%>
          </select>
        </form>
        
      </li>
      <!-- End of search bar -->
       <div class="d-flex justify-content-end align-self-end me-4 me-lg-0 mb-2 gap-1 gap-lg-0 order-lg-2">
          <a href="/cart" class="nav-item nav-button mx-lg-2 mx-md-1 mx-sm-1 p-3 d-flex align-self-center rounded-circle">
            <svg class="bi" width="32" height="32" fill="currentColor">
              <use xlink:href="bootstrap-icons.svg#cart3" />
            </svg>
          </a>
          <a href="/wishlist" class="nav-item nav-button mx-lg-2 mx-md-1 mx-sm-1 p-3 d-flex align-self-center rounded-circle">
            <svg class="bi" width="32" height="32" fill="currentColor">
              <use xlink:href="bootstrap-icons.svg#heart" />
            </svg>
          </a>
          <a href="/account" class="nav-item nav-button mx-lg-2 mx-md-1 mx-sm-1 p-3 d-flex align-self-center rounded-circle">
            <svg class="bi" width="32" height="32" fill="currentColor">
              <use xlink:href="bootstrap-icons.svg#person" />
            </svg>
          </a>
       </div>
    </ul>
  </div>
</nav>
<!-- Include the plugin's CSS and JS: -->
<script type="text/javascript" src="/dist/js/bootstrap-multiselect.js"></script>
<link rel="stylesheet" href="/dist/css/bootstrap-multiselect.css">
<script type="text/javascript">
    $(document).ready(() => {
        $('#category-selection').multiselect({
          includeSelectAllOption: true,
          buttonText: (options, select) => {
            return "Categories";
          },
          buttonClass: 'h-100 rounded-end-5 d-flex align-items-center justify-content-center border-0'
        });
    });
</script>
