<script type="text/javascript" src="/dist/jquery.min.js"></script>
<nav class="navbar navbar-expand-lg bg-custom my-3 nav-animate">
  <div class="container align-items-start justify-content-center">
    <div class="navbar-brand rounded-5 d-flex px-2">
      <a href="/">
        <img class="rounded-circle" id="brand-icon" src="/assets/KD5FIcon.png" alt="KD5F icon" />
      </a>
      <div class="category-container px-3">
          <!-- Brand Category Dropdown -->
          <div class="nav-item dropdown">
            <a class="dropdown-toggle-custom text-decoration-none link-light d-block" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi-tags-fill fs-3"></i>
              <p>Category</p>
            </a>
            <!-- Dropdown menu -->
            <form action="/result" method="get" class="dropdown-menu">
              <% categories.forEach(category=> { %>
                <li>
                  <button type="submit" name="category" value="<%=category.category_id%>" class="dropdown-item">
                    <%=category.name%>
                  </button>
                </li>

                <%});%>
            </form>
          </div>
      </div>
    </div>
    <ul class="navbar-nav flex-grow-1">
      <!-- Search bar -->
      <li class="nav-item search-bar mx-4 mt-lg-0 mt-sm-2 mt-md-2 flex-grow-1 order-1 order-sm-4 order-md-4 order-lg-1">
        <form class="d-flex h-100 w-100 align-items-center" action="/result" method="get">
          <!-- Search Button -->
          <button class="ps-3 rounded-start-5" id="search-button" type="submit">
            <i class="bi-search fs-4"></i>
          </button>

          <!-- Search Input -->
          <input class="d-flex flex-grow-1 h-100 px-2" type="text" name="gameName" id="search-input" placeholder="Search here"/>

          <!-- Category Dropdown -->
          <select name="categories" id="category-selection" multiple="multiple">
            <% categories.forEach(category => { %>
              <option value="<%=category.category_id%>"><%=category.name%></option>
            <%});%>
          </select>
        </form>
        
      </li>
      <!-- End of search bar -->
       <div class="d-flex justify-content-end align-self-end me-4 me-lg-0 mb-2 gap-1 gap-lg-0 order-lg-2">
          <a href="/cart" class="nav-item nav-button mx-lg-2 mx-md-1 mx-sm-1 p-3 d-block align-self-center rounded-circle">
            <i class="bi-cart3 fs-3"></i>
          </a>
          <a href="/wishlist" class="nav-item nav-button mx-lg-2 mx-md-1 mx-sm-1 p-3 d-block align-self-center rounded-circle">
            <i class="bi-heart fs-3"></i>
          </a>
          <a href="/account" class="nav-item nav-button mx-lg-2 mx-md-1 mx-sm-1 p-3 d-block align-self-center rounded-circle">
            <i class="bi-person fs-3"></i>
          </a>
       </div>
    </ul>
  </div>
</nav>
