<!-- Include the plugin's CSS and JS: -->
<script type="text/javascript" src="/bootstrap-multiselect/dist/js/bootstrap-multiselect.js"></script>
<link rel="stylesheet" href="/bootstrap-multiselect/dist/css/bootstrap-multiselect.css">
<script type="text/javascript">
    $(document).ready(() => {
        $('#category-selection').multiselect({
          includeSelectAllOption: true,
          buttonText: (options, select) => {
            return "Categories";
          },
          buttonClass: 'h-100 rounded-end-5 d-flex align-items-center justify-content-center border-0',
          templates: {
              ul: '<ul class="multiselect-container dropdown-menu dropdown-menu-end"></ul>'
          },
          onChange: (element, checked) => {
            if (checked === true) {

            }
          }
        });

        // Close dropdown when clicking outside
        $(document).on('click', function(e) {
          const $target = $(e.target);
          const $multiselect = $('#category-selection').closest('.multiselect-native-select');
          
          // Check if click is outside the multiselect component
          if (!$target.closest('.multiselect-native-select').length && 
              !$target.closest('.multiselect-container').length) {
            const $dropdown = $multiselect.find('.multiselect-container');
            if ($dropdown.is(':visible')) {
              // Hide dropdown by removing the show class
              $dropdown.hide();
            }
          }
        });
    });
</script>
