          <button class="ps-3 rounded-start-5" id="search-button" type="submit">
            <i class="bi-search fs-4"></i>
          </button>

          <!-- Search Input -->
          <input class="d-flex flex-grow-1 h-100 px-2" type="text" name="gameName" id="search-input" placeholder="Search here"/>

          <!-- Category Dropdown -->
          <select name="categories" id="category-selection" multiple="multiple">
            <% categories.forEach(category => { %>
              <option value="<%=category.category_id%>"><%=category.name%></option>
            <%});%>
          </select>
        </form>
        
      </li>
