<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD5F - <%=gameDetails.name%></title>
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/styles/style.css" />
    <link rel="stylesheet" href="/styles/productDetail.css" />
    <link rel="stylesheet" href="/styles/animations.css" />
  </head>
  <body data-game-id="<%=gameDetails.product_id%>" data-images="<%=images%>" data-videos="<%=videos%>">
    <%- include('partials/navbar') %>
    <main class="container my-4">
      <a href="/" class="back-to-home scroll-reveal"><p>< Back to Home</p></a>
      <!-- detail -->
      <div class="contentBox p-4 pt-5 rounded-4 scroll-reveal" style="--reveal-delay: 100ms">
        <div class="row">
        <!-- Left: Images -->
        <div class="col-md-8 align-items-center">
          <div class="image-gallery gap-3">
            <div class="side-thumbnail mx-auto text-center text-md-start">
              <img src="<%=gameDetails.poster_url%>" alt="game poster" class="rounded w-100" />
            </div>
            <div id="main-image" class="mx-auto flex-grow-1">
              <img
                src=""
                alt="Game Image"
                class="rounded-3 mx-auto"
              />
              <iframe src=""
                width="555"
                height="256"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                class="rounded-3 h-100 w-100 mx-auto"
                style="display: none;"
                allowfullscreen>
              </iframe>
            </div>
          </div>
          <!-- Thumbnail carousel (desktop) -->
          <div class="d-flex align-items-center mt-3 thumbnail-carousel my-lg-0 my-3 py-3">
            <button type="button" id="left-arrow" class="btn btn-sm carousel-arrow rounded-circle">
              <i class="bi bi-arrow-left"></i>
            </button>
            <div class="d-flex gap-2 thumb-container flex-grow-1">
              <% videos.forEach((video, index) => {%>
                <div class="position-relative thumb-item rounded" data-index="<%=index%>" style="cursor: pointer; display: inline-block;">
                  <img 
                    src="https://img.youtube.com/vi/<%=video%>/hqdefault.jpg" 
                    alt="Video Preview" 
                    class="w-100 h-100 rounded object-fit-cover"
                  />
                  <div class="position-absolute top-50 start-50 translate-middle text-white" style="pointer-events: none;">
                    <i class="bi bi-play-circle-fill fs-4" style="color: #B7EF00;"></i>
                  </div>
                </div>
              <%});%>
              <% images.forEach((image, index) => { %>
              <img
                src="<%=image%>"
                alt="thumbnail <%=index%>"
                class="img-fluid rounded thumb-item"
                data-index="
                <% if (videos.length === 1) {%>
                  <%=index+1%>
                <%} else if (videos.length === 2) { %>
                  <%=index+2%>
                <%} else { %>
                  <%=index%>
                <%} %>"
              />
              <%});%>
            </div>
            <button type="button" id="right-arrow" class="btn btn-sm carousel-arrow rounded-circle">
              <i class="bi bi-arrow-right"></i>
            </button>
          </div>
          <!-- Dot indicators (mobile) -->
          <div class="dot-indicators my-3">
            <% videos.forEach((video, index) => {%>
              <span class="dot rounded-circle" data-index="<%=index%>"></span>
            <%});%>
            <% images.forEach((image, index) => { %>
              <span class="dot rounded-circle" 
                data-index="
                <% if (videos.length === 1) {%>
                  <%=index+1%>
                <%} else if (videos.length === 2) { %>
                  <%=index+2%>
                <%} else { %>
                  <%=index%>
                <%} %>"></span>
            <% }) %>
          </div>
        </div>
        <!-- Right: Info -->
        <div class="col-md-4 d-flex flex-column justify-content-center">
          <h1 class="game-title ps-3"><%=gameDetails.name%></h1>
          <p class="breadcrumb-text"><%=gameDetails.category%></p>
          <p class="seller-info ps-3">Seller: <%=gameDetails.username%></p>
          <p class="price-text">
            Price: <span class="price-value">$<%=gameDetails.price%></span>
          </p>
          <div class="d-flex align-items-center gap-3">
            <!-- add to cart button -->
            <button class="btn add-to-cart-btn w-100 h-100">
              <% if (isInCart) { %>
                <i class="bi-cart-plus-fill"></i>
              <% } else { %>
                <i class="bi-cart-plus"></i>
              <% } %> ADD TO CART
            </button>
            <!-- add to wishlist button -->
            <button class="btn wishlist-btn">
            <% if (isWishlisted) { %>
              <i class="bi-heart-fill"></i>
            <%} else { %>
              <i class="bi-heart"></i>
            <%}%>
            </button>
          </div>
        </div>
        </div>
      </div>

      <!-- description -->
      <div class="contentBox mt-4 rounded-4 px-5 py-5 scroll-reveal" style="--reveal-delay: 200ms">
        <div class="fs-3 fw-bold mb-3">DESCRIPTION</div>
        <div class="section p-3 rounded-4">
          <p><%=gameDetails.description%></p>
        </div>
      </div>

      <!-- system requirements -->
      <div class="contentBox mt-4 rounded-4 px-5 py-5 scroll-reveal" style="--reveal-delay: 300ms">
        <div class="fs-3 fw-bold mb-3">SYSTEM REQUIREMENTS</div>
        <div class="row section p-3 rounded-4">
          <div class="col-lg-6">
            <p class="fs-5 lh-sm fw-bold">Minimum</p>
              <% if (requirements.length>1) { %>
              OS: <%=requirements[0].operating_system%> <br>
              Processor: <%=requirements[0].processor%> <br>
              Memory: <%=requirements[0].memory%> <br>
              Graphic: <%=requirements[0].graphics_card%> <br>
              DirectX: <%=requirements[0].directx_version%> <br>
              Network: <%=requirements[0].network%> <br>
              Storage: <%=requirements[0].storage%> <br>
              Soundcard: <%=requirements[0].soundcard%> <br>
              Additional notes: <%=requirements[0].additional_note%></p>
            <%} else {%>
              OS: - <br>
              Processor: - <br>
              Memory: - <br>
              Graphic: - <br>
              DirectX: - <br>
              Network: - <br>
              Storage: - <br>
              Soundcard: - <br>
              Additional notes: -</p>
            <%}%>
          </div>
          <div class="col-lg-6">
            <p class="fs-5 lh-sm fw-bold">Recommended</p>
              <% if (requirements.length>1) { %>
              OS: <%=requirements[1].operating_system%> <br>
              Processor: <%=requirements[1].processor%> <br>
              Memory: <%=requirements[1].memory%> <br>
              Graphic: <%=requirements[1].graphics_card%> <br>
              DirectX: <%=requirements[1].directx_version%> <br>
              Network: <%=requirements[1].network%> <br>
              Storage: <%=requirements[1].storage%> <br>
              Soundcard: <%=requirements[1].soundcard%> <br>
              Additional notes: <%=requirements[1].additional_note%></p>
            <%} else {%>
              OS: - <br>
              Processor: - <br>
              Memory: - <br>
              Graphic: - <br>
              DirectX: - <br>
              Network: - <br>
              Storage: - <br>
              Soundcard: - <br>
              Additional notes: -</p>
            <%}%>
          </div>
        </div>

      </div>
    </main>
    <%-include('partials/popup/sessionExpired')%>
    <%- include('partials/footer') %>
  </body>
  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/axios/dist/axios.min.js"></script>
  <script src="/scripts/notify.js"></script>
  <script src="/scripts/scroll-reveal.js"></script>
  <script src="/scripts/detail.js"></script>
  <script src="/scripts/session-expiry.js"></script>
</html>
