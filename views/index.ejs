<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD5F - Homepage</title>

    <!-- Link Bootstrap -->
    <link rel="stylesheet" href="/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <!-- Link style.css -->
    <link rel="stylesheet" href="/styles/style.css" />
  </head>
  <body>
    <!-- Navbar -->
    <%-include('buyer/partials/navbar');%>
    <main data-username="<%=username%>" class="container my-4">
      <!-- Carousel -->
      <%-include('buyer/partials/carousel');%>

      <!-- Game Cards Grid -->
      <div class="container">
        <div class="row gap-4 justify-content-center align-items-start">
          <% games.forEach((game) => { %>
            <%-include('buyer/partials/gameCard', { game: game});%>
          <%})%>
        </div>
      </div>

      <!-- Explore more Text -->
      <% if (username !== null) { %>
        <a href="/result">Explore more</a>
      <%} else {%>
        <p id="explore">
        Explore more: <a href="/identification" id="login-text">Log in</a> or
        <a href="/register" id="register-text">Register</a>
      </p>
      <%}%>
    </main>

    <%-include('buyer/partials/footer')%>
    <script src="/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/dist/axios.min.js"></script>
    <script src="/scripts/product.js" defer></script>
  </body>
  <style>
    #explore {
      margin: 25px;
      text-align: center;
      font-size: 2rem;
    }
    #login-text,
    #register-text {
      color: #b7ef00;
      text-decoration: underline;
    }
  </style>
</html>
