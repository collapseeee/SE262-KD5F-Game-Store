<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD5F - Dashboard</title>
    <!-- Link Bootstrap -->
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=visibility,visibility_off" />

    <!-- Link style.css -->
    <link rel="stylesheet" href="/styles/style.css" />
  </head>
  <body onload="currentVisibility()">
    <%-include('partials/navbar')%>
    <main class="container my-4">
    <div class="section-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title">CATEGORY LIST</h2>
            <button class="btn btn-add" onclick="addCategoryRow()">ADD</button>
        </div>

        <div id = "categories" class="table-responsive table-category">
            <table class="custom-table w-100">
                <thead>
                    <tr style="background-color: rgba(0,0,0,0.2);">
                        <th class="ps-3 py-3">Category Name</th>
                        <th class="text-end pe-3"></th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach((cat, index) => { %>
                        <tr id="row-cat-<%= index %>" class="<%= index % 2 === 0 ? 'row-color-1' : 'row-color-2' %>">
                        <td class="ps-3 py-3 text-white">
                            <span class="view-mode"><%= cat.name %></span>
                            <input type="text"
                                    class="form-control edit-mode d-none custom-input" 
                                    value="<%= cat.name %>"
                                    onkeyup="if(event.key === 'Enter') saveEdit('<%= index %>', <%= cat.category_id %>)">
                        </td>
                        <td class="text-end pe-3">
                            <div class="d-none d-lg-flex justify-content-end align-items-center gap-3">
                                <span class="material-symbols-outlined icon-visibility"
                                    id="vis-cat-<%= index %>"
                                    data-category-id="<%=cat.category_id%>"
                                    onclick="toggleVisibility('vis-cat-<%= index %>')">
                                    visibility
                                </span>
                                
                                <div class="d-flex gap-2">
                                    <button class="btn btn-action-edit view-mode" onclick="enableEdit('<%= index %>')">Rename</button>
                                    <button class="btn btn-action-delete view-mode" onclick="deleteCategory(<%= cat.category_id %>)">Delete</button>
                                    <button class="btn btn-action-done edit-mode d-none" onclick="saveEdit('<%= index %>', <%= cat.category_id %>)">Done</button>
                                    <button class="btn btn-action-delete edit-mode d-none" onclick="disableEdit('<%= index %>')">Delete</button>
                                </div>
                            </div>
                            <div class="dropdown d-lg-none">
                                    <button class="btn text-white border-0 p-0"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-offset="0,2"
                                            data-bs-display="static"
                                            data-bs-popper-config='{"placement":"bottom-end","modifiers":[{"name":"flip","enabled":false}]}'
                                            aria-expanded="false">
                                        <i class="bi bi-three-dots fs-2"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end custom-popover shadow">
                                        <button class="btn btn-popover-rename view-mode" onclick="enableEdit('<%= index %>')">Rename</button>
                                        <button class="btn btn-popover-delete view-mode" onclick="deleteCategory(<%= cat.category_id %>)">Delete</button>
                                    </ul>
                                </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div id="products" class="section-container table-product">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title">GAMES</h2>
            <button class="btn btn-add" onclick="addCategoryRow()">ADD</button>
        </div>

        <div class="table-responsive">
            <table class="custom-table w-100">
                <thead>
                    <tr style="background-color: rgba(0,0,0,0.2);">
                        <th class="ps-3 py-3">Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th class="text-end pe-3"></th>
                    </tr>
                </thead>
                <tbody>
                    <% games.forEach((game, index) => { %>
                        <tr class="<%= index % 2 === 0 ? 'row-color-1' : 'row-color-2' %>">
                            <td class="ps-3 py-3 text-white"><%= game.name %></td>
                            <td class="text-white"><%= game.category %></td>
                            <td class="text-white">$<%= game.price %></td>
                            <td class="text-end pe-3">
                                <div class="d-none d-lg-flex justify-content-end align-items-center gap-2">
                                    <button class="btn btn-action-edit" onclick="window.location.href = '/api/product/edit/<%= game.product_id %>'">Edit</button>
                                    <button class="btn btn-action-delete" onclick="deleteproduct(<%= game.product_id %>)">Delete</button>
                                </div>

                                <div class="dropdown d-lg-none">
                                    <button class="btn text-white border-0 p-0"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-offset="0,2"
                                            data-bs-display="static"
                                            data-bs-popper-config='{"placement":"bottom-end","modifiers":[{"name":"flip","enabled":false}]}'
                                            aria-expanded="false">
                                        <i class="bi bi-three-dots fs-2"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end custom-popover shadow">
                                        <li class="px-3 py-2"><a class="btn btn-popover-edit w-100" href="/api/product/edit/<%= game.product_id %>">Edit</a></li>
                                        <li class="px-3 py-2"><a class="btn btn-popover-delete w-100" onclick="deleteproduct(<%= game.product_id %>)">Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</main>
    <%- include('../buyer/partials/popup/sessionExpired')%>
    <%- include('partials/footer')%>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/axios/dist/axios.min.js"></script>
    <script src="/scripts/session-expiry.js"></script>
  </body>
</html>
<script>

const currentVisibility = async () => {
    const categories = await axios.get('/api/categories').then( data => { return data.data; });
    for (let i = 0; i < categories.length; i++) {
        if (categories[i].isHidden === 1) {
            const icon = document.body.querySelector(`#vis-cat-${i}`);
            const row = icon.closest('tr');
            icon.innerText = 'visibility_off';
            icon.style.opacity = '0.5';
            row.style.opacity = '0.5';
            row.style.transition = '0.3s';
        }
    }
};




async function deleteCategory(id) {
        try {
            const response = await fetch(`/categories/${id}`, {
                method: 'DELETE'
            });
            const result = await response.json();
            if (result.success) {
                window.location.reload();
            } else {
                alert("Error in database");
            }
        } catch (error) {
            console.error("Error:", error);
            alert("cannot connect Server");
        }
    }

    async function deleteproduct(id) {
    try {
        const response = await fetch(`/api/games/${id}`, {
            method: 'DELETE'
        });
        const result = await response.json();
        if (!response.ok) {
            alert(result.message || "Delete failed");
            return;
        }
        // success
        if (result.success) {
            window.location.reload();
        }

    } catch (error) {
        console.error("Error:", error);
        alert("Cannot connect to server");
    }
}
    function enableEdit(index) {
    const row = document.getElementById(`row-cat-${index}`);
    
    // switch view mode and edit mode
    row.querySelectorAll('.view-mode').forEach(el => el.classList.add('d-none'));
    row.querySelectorAll('.edit-mode').forEach(el => el.classList.remove('d-none'));
    
    const input = row.querySelector('input.edit-mode');
    input.focus();
    input.select(); // Highlight text for easy editing
}

function disableEdit(index) {
    const row = document.getElementById(`row-cat-${index}`);
    row.querySelectorAll('.view-mode').forEach(el => el.classList.remove('d-none'));
    row.querySelectorAll('.edit-mode').forEach(el => el.classList.add('d-none'));
}

async function saveEdit(index, id) {
    const row = document.getElementById(`row-cat-${index}`);
    const newName = row.querySelector('input.edit-mode').value;
    try {
        const response = await fetch(`/categories/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: newName })
        });
        const result = await response.json();
        if (result.success) {
            window.location.reload();
        }
    } catch (error) {
        console.error("Save failed:", error);
    }
}
function addCategoryRow() {
    const existingNewRow = document.getElementById('row-cat-new');
    if (existingNewRow) {
        existingNewRow.querySelector('input').focus();
        return;
    }

    const tbody = document.querySelector('.table-category tbody');
    
    const tempIndex = 'new';
    
    const isEven = tbody.children.length % 2 === 0;
    const rowClass = isEven ? 'row-color-1' : 'row-color-2';

    const newRow = `
        <tr id="row-cat-${tempIndex}" class="${rowClass}">
            <td class="ps-3 py-3 text-white">
                <input type="text"
                        class="form-control edit-mode custom-input" 
                        placeholder="New Category Name..."
                        onkeyup="if(event.key === 'Enter') saveNewCategory('${tempIndex}')">
            </td>
            <td class="text-end pe-3">
                <div class="d-none d-lg-flex justify-content-end align-items-center gap-3">
                    <div class="d-flex gap-2">
                        <button class="btn btn-action-done edit-mode" onclick="saveNewCategory('${tempIndex}')">Done</button>
                        <button class="btn btn-action-delete edit-mode" onclick="cancelNewCategory('${tempIndex}')">Cancel</button>
                    </div>
                </div>
                <div class="d-flex d-lg-none justify-content-end gap-2">
                    <button class="btn btn-action-done edit-mode px-2 py-1" onclick="saveNewCategory('${tempIndex}')">Done</button>
                    <button class="btn btn-action-delete edit-mode px-2 py-1" onclick="cancelNewCategory('${tempIndex}')">Cancel</button>
                </div>
            </td>
        </tr>
    `;

    tbody.insertAdjacentHTML('beforeend', newRow);

    document.querySelector(`#row-cat-${tempIndex} input`).focus();
}

function cancelNewCategory(index) {
    const row = document.getElementById(`row-cat-${index}`);
    if (row) row.remove();
}

async function saveNewCategory(index) {
    const row = document.getElementById(`row-cat-${index}`);
    const inputField = row.querySelector('input.edit-mode');
    const newName = inputField.value.trim();

    if (!newName) {
        alert("Please enter a category name.");
        inputField.focus();
        return;
    }

    try {
        const response = await fetch('/api/addcategorie', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: newName })
        });
        
        const result = await response.json();
        if (result.success) {
            window.location.reload();
        } else {
            alert("Error saving new category");
        }
    } catch (error) {
        console.error("Save failed:", error);
        alert("Cannot connect to Server");
    }
}
</script>
<style>
    
body {
    background-color: #8122C9;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Container (Category / Games) */
.section-container {
    background-color: #8B00F5;
    border-radius: 25px;
    padding: 25px;
    width: 100%;
    max-width: 1340px;
    margin: 0 auto 40px auto;
    overflow: visible !important;
    height: auto !important;
}

/*  Section */
.section-title {
    color: white;
    font-weight: 800;
    font-size: 1.8rem;
    margin: 0;
}

/*  ADD Button*/
.btn-add {
    background-color: #B7EF00;
    color: #4b0082;
    font-weight: bold;
    border: none;
    border-radius: 12px;
    padding: 8px 45px;
    transition: transform 0.2s;
}

.btn-add:hover {
    background-color: #96db00;
    transform: scale(1.05);
}


.custom-table {
    width: 100%;
    color: white;
    border-collapse: separate;
    border-spacing: 0 5px;
}

.custom-table thead tr {
    background-color: rgba(0, 0, 0, 0.15);
}

.custom-table th {
    padding: 15px;
    font-weight: 600;
    border: none;
}

.custom-table tbody tr {
    background-color: rgba(255, 255, 255, 0.05);
}


.custom-table tbody tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.1);
}

.custom-table td {
    padding: 12px 15px;
    vertical-align: middle;
}

.custom-table tbody tr {
    position: relative;
}
.custom-table tbody tr:has(.show) {
    z-index: 1050 !important;
}
/* Rename / Edit */
.btn-action-edit {
    background-color: #8c00ff;
    color: white;
    border: 1.5px solid #bd70ff;
    border-radius: 20px;
    padding: 4px 18px;
    font-size: 0.9rem;
}

.btn-action-edit:hover {
    background-color: #bd70ff;
    color: white;
}

/* Delete */
.btn-action-delete {
    background-color: #e60000;
    color: white;
    border: none;
    border-radius: 20px;
    padding: 4px 18px;
    font-size: 0.9rem;
    margin-left: 5px;
}

.row-color-1 {
    background-color: #3F324A !important;
}


.row-color-2 {
    background-color: #5C3B75 !important;
}


.custom-table tbody tr:first-child td:first-child { border-top-left-radius: 10px; }
.custom-table tbody tr:first-child td:last-child { border-top-right-radius: 10px; }
.custom-table tbody tr:last-child td:first-child { border-bottom-left-radius: 10px; }
.custom-table tbody tr:last-child td:last-child { border-bottom-right-radius: 10px; }

.custom-table {
    border-spacing: 0;
    overflow: visible !important;
}

/* --- Popover (Mobile) --- */

.dropdown-menu.custom-popover {
    position: absolute !important;
    inset: 100% -6px auto auto !important;
    transform: none !important;
    margin-top: 1px !important;
    background-color: #8B00F5 !important;
    border-radius: 20px !important;
    border: none !important;
    min-width: 100px;
    height: auto !important;
    padding: 12px 0 !important;
    z-index: 9999 !important;
    display: none;
}

.dropdown-menu.custom-popover.show {
    display: block;
}

/* Arrow Triangle*/
.custom-popover::before {
    content: "";
    position: absolute;
    top: -7px;
    right: 8px;
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    border-bottom: 15px solid #8B00F5;
}

/* Button in Popover */
.btn-popover-edit, .btn-popover-delete, .btn-popover-rename {
    width: 80px !important;
    height: 35px !important;
    font-size: 0.9rem !important;
    font-weight: 700 !important;
    padding: 0 !important;
    margin: 5px auto !important;
    border-radius: 50px !important;
    border: none !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    color: white !important;
}

.btn-popover-edit { background-color: #FFB338 !important; }
.btn-popover-delete { background-color: #C91C1C !important; }
.btn-popover-rename { background-color: #FFB338 !important; }

.dropdown-menu {
    --bs-dropdown-bg: transparent;
    --bs-dropdown-border-color: transparent;
}

.table-responsive {
    overflow: visible !important;
}

.icon-visibility {
    user-select: none;
    transition: transform 0.2s ease;
    position: relative;
    top: 3px;
    font-size: 32px !important;
    margin-bottom: 0;
    display: inline-flex;
    align-items: center;
    
}

.icon-visibility:hover {
    transform: scale(1.2);
}

.custom-input {
    background-color: #C8B6D6 !important;
    border: none !important;
    border-radius: 5px;
    color: #4b0082 !important;
    font-weight: 600;
    padding: 5px 10px;
    width: 250px;
}

.btn-action-done {
    background-color: #B7EF00 !important;
    color: #4b0082 !important;
    font-weight: bold;
    border: none;
    border-radius: 20px;
    padding: 4px 25px;
    font-size: 0.9rem;
}

.btn-action-done:hover {
    background-color: #96db00;
}

.edit-mode.btn-action-delete {
    background-color: #D32F2F !important;
}
</style>