<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD5F - Wishlist</title>
    <!-- Link Bootstrap -->
    <link rel="stylesheet" href="/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=visibility,visibility_off" />

    <!-- Link style.css -->
    <link rel="stylesheet" href="/styles/style.css" />
  </head>
  <body>
    <%-include('partials/navbar')%>
    <main class="container my-4">
    <div class="section-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title">CATEGORY LIST</h2>
            <button class="btn btn-add">ADD</button>
        </div>

        <div class="table-responsive">
            <table class="custom-table w-100">
                <thead>
                    <tr style="background-color: rgba(0,0,0,0.2);">
                        <th class="ps-3 py-3">Category Name</th>
                        <th class="text-end pe-3"></th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach((cat, index) => { %>
                        <tr class="<%= index % 2 === 0 ? 'row-color-1' : 'row-color-2' %>">
                            <td class="ps-3 py-3 text-white">Category <%= index + 1 %></td>
                            <td class="text-end pe-3">
                            <div class="dropdown d-lg-none">
                                <button class="btn text-white border-0 p-0"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-offset="0,2"
                                        data-bs-display="static"
                                        data-bs-popper-config='{"placement":"bottom-end","modifiers":[{"name":"flip","enabled":false}]}'
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots fs-2"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end custom-popover shadow">
                                    <li class="px-3 py-2"><a class="btn btn-popover-edit w-100" href="#">Rename</a></li>
                                    <li class="px-3 py-2"><a class="btn btn-popover-delete w-100" href="#">Delete</a></li>
                                </ul>
                            </div>

                           <div class="d-none d-lg-flex justify-content-end align-items-center gap-3">
                                <span class="material-symbols-outlined icon-visibility"
                                    id="vis-cat-<%= index %>"
                                    style="cursor: pointer; color: white;"
                                    onclick="toggleVisibility('vis-cat-<%= index %>')">
                                    visibility
                                </span>
                                
                                <div class="d-flex gap-2">
                                    <button class="btn btn-action-edit">Rename</button>
                                    <button class="btn btn-action-delete" onclick="deleteItem('categories', <%= cat.id %>)">Delete</button>
                                </div>
                            </div>
                        </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="section-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title">GAMES</h2>
            <button class="btn btn-add">ADD</button>
        </div>

        <div class="table-responsive">
            <table class="custom-table w-100">
                <thead>
                    <tr style="background-color: rgba(0,0,0,0.2);">
                        <th class="ps-3 py-3">Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th class="text-end pe-3"></th>
                    </tr>
                </thead>
                <tbody>
                    <% games.forEach((game, index) => { %>
                        <tr class="<%= index % 2 === 0 ? 'row-color-1' : 'row-color-2' %>">
                            <td class="ps-3 py-3 text-white">Game <%= index + 1 %></td>
                            <td class="text-white">Category <%= game.category_id %></td>
                            <td class="text-white">$<%= game.price %></td>
                            <td class="text-end pe-3">
                                <div class="d-none d-lg-flex justify-content-end align-items-center gap-2">
                                    <span class="material-symbols-outlined icon-visibility"
                                        id="vis-game-<%= index %>"
                                        style="cursor: pointer; color: white;"
                                        onclick="toggleVisibility('vis-game-<%= index %>')">
                                        visibility
                                    </span>
                                    <button class="btn btn-action-edit">Edit</button>
                                    <button class="btn btn-action-delete">Delete</button>
                                </div>

                                <div class="dropdown d-lg-none">
                                    <button class="btn text-white border-0 p-0"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-offset="0,2"
                                            data-bs-display="static"
                                            data-bs-popper-config='{"placement":"bottom-end","modifiers":[{"name":"flip","enabled":false}]}'
                                            aria-expanded="false">
                                        <i class="bi bi-three-dots fs-2"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end custom-popover shadow">
                                        <li class="px-3 py-2"><a class="btn btn-popover-edit w-100" href="#">Edit</a></li>
                                        <li class="px-3 py-2"><a class="btn btn-popover-delete w-100" href="#">Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</main>
    <%- include('partials/footer')%>
    <script src="/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
<script>
function toggleVisibility(id) {
    const icon = document.getElementById(id);
    const row = icon.closest('tr'); // หาแถว (tr) ที่ไอคอนนี้อยู่
    
    if (icon.innerText === 'visibility') {
        // เปลี่ยนเป็นสถานะ ปิด
        icon.innerText = 'visibility_off';
        icon.style.opacity = '0.5';
        row.style.opacity = '0.5'; // ทำให้ทั้งแถวดูจางลง
        row.style.transition = '0.3s';
    } else {
        // เปลี่ยนเป็นสถานะ เปิด
        icon.innerText = 'visibility';
        icon.style.opacity = '1';
        row.style.opacity = '1';
        row.style.transition = '0.3s';
    }
}

async function deleteItem(type, id) {
        try {
            // ส่ง Request ไปยัง Endpoint ที่เราสร้างไว้
            const response = await fetch(`/${type}/${id}`, {
                method: 'DELETE'
            });

            const result = await response.json();

            if (result.success) {
                // ถ้า Server ลบสำเร็จ ให้รีโหลดหน้าเพื่ออัปเดตตาราง
                window.location.reload();
            } else {
                alert("เกิดข้อผิดพลาดในการลบข้อมูล");
            }
        } catch (error) {
            console.error("Error:", error);
            alert("ไม่สามารถติดต่อ Server ได้");
        }
    }
</script>
<style>
    /* กำหนดพื้นหลังหลักของหน้าเว็บ */
body {
    background-color: #8122C9; /* สีม่วงหลักตามภาพ */
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Container ของแต่ละส่วน (Category / Games) */
/* Container: ปรับให้ยืดหยุ่นและไม่ตัดขอบเมนู */
.section-container {
    background-color: #8B00F5;
    border-radius: 25px;
    padding: 25px;
    width: 100%;
    max-width: 1340px;
    margin: 0 auto 40px auto;
    overflow: visible !important; /* ยอมให้เมนูลอยทับออกมาได้ */
    height: auto !important;
}

/* หัวข้อ Section */
.section-title {
    color: white;
    font-weight: 800;
    font-size: 1.8rem;
    margin: 0;
}

/* ปุ่ม ADD สีเขียวนีออน */
.btn-add {
    background-color: #B7EF00;
    color: #4b0082;
    font-weight: bold;
    border: none;
    border-radius: 12px;
    padding: 8px 45px;
    transition: transform 0.2s;
}

.btn-add:hover {
    background-color: #96db00;
    transform: scale(1.05);
}

/* การจัดการตาราง */
.custom-table {
    width: 100%;
    color: white;
    border-collapse: separate;
    border-spacing: 0 5px; /* เว้นระยะระหว่างแถว */
}

.custom-table thead tr {
    background-color: rgba(0, 0, 0, 0.15);
}

.custom-table th {
    padding: 15px;
    font-weight: 600;
    border: none;
}

.custom-table tbody tr {
    background-color: rgba(255, 255, 255, 0.05);
}

/* สลับสีแถวเข้ม-อ่อน */
.custom-table tbody tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.1);
}

.custom-table td {
    padding: 12px 15px;
    vertical-align: middle;
}

.custom-table tbody tr {
    position: relative;
}
.custom-table tbody tr:has(.show) {
    z-index: 1050 !important;
}
/* ปุ่ม Rename / Edit */
.btn-action-edit {
    background-color: #8c00ff;
    color: white;
    border: 1.5px solid #bd70ff;
    border-radius: 20px;
    padding: 4px 18px;
    font-size: 0.9rem;
}

.btn-action-edit:hover {
    background-color: #bd70ff;
    color: white;
}

/* ปุ่ม Delete */
.btn-action-delete {
    background-color: #e60000;
    color: white;
    border: none;
    border-radius: 20px;
    padding: 4px 18px;
    font-size: 0.9rem;
    margin-left: 5px;
}
/* สีแถวที่ 1 (#3F324A) */
.row-color-1 {
    background-color: #3F324A !important;
}

/* สีแถวที่ 2 (#5C3B75) */
.row-color-2 {
    background-color: #5C3B75 !important;
}

/* ปรับให้ขอบมนเฉพาะแถวแรกและแถวสุดท้ายในตาราง */
.custom-table tbody tr:first-child td:first-child { border-top-left-radius: 10px; }
.custom-table tbody tr:first-child td:last-child { border-top-right-radius: 10px; }
.custom-table tbody tr:last-child td:first-child { border-bottom-left-radius: 10px; }
.custom-table tbody tr:last-child td:last-child { border-bottom-right-radius: 10px; }

/* จัดการระยะห่างเล็กน้อย */
.custom-table {
    border-spacing: 0;
    overflow: visible !important;
}

/* --- Popover (Mobile) --- */
/* แก้ไขจากของเดิม */
.dropdown-menu.custom-popover {
    position: absolute !important;
    /* บังคับให้ออกด้านล่างและชิดขวาเสมอ ป้องกันการดีดขึ้นบน */
    inset: 100% -6px auto auto !important;
    transform: none !important;
    margin-top: 1px !important;
    background-color: #8B00F5 !important;
    border-radius: 20px !important;
    border: none !important;
    min-width: 100px;
    height: auto !important;
    padding: 12px 0 !important;
    z-index: 9999 !important;
    /* เพิ่มส่วนนี้เพื่อให้ทำงานร่วมกับ data-bs-display="static" ได้ดีขึ้น */
    display: none;
}

.dropdown-menu.custom-popover.show {
    display: block;
}

/* Arrow Triangle*/
.custom-popover::before {
    content: "";
    position: absolute;
    top: -7px;
    right: 8px; /* ค่าที่ทำให้ตรงจุดที่ 2 ของไข่ปลา */
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    border-bottom: 15px solid #8B00F5;
}

/* ปุ่มภายใน Popover */
.btn-popover-edit, .btn-popover-delete {
    width: 80px !important;    /* กำหนดความกว้าง */
    height: 35px !important;   /* กำหนดความสูง */
    font-size: 0.9rem !important; /* ลดขนาดฟอนต์ลงเพื่อให้พอดีกับปุ่มที่เล็กลง */
    font-weight: 700 !important;
    padding: 0 !important;      /* ล้าง padding เดิม */
    margin: 5px auto !important; /* ปรับระยะห่างระหว่างปุ่ม */
    border-radius: 50px !important;
    border: none !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    color: white !important;
}

.btn-popover-edit { background-color: #FFB338 !important; }
.btn-popover-delete { background-color: #C91C1C !important; }

/* ล้างสไตล์ Bootstrap */
.dropdown-menu {
    --bs-dropdown-bg: transparent;
    --bs-dropdown-border-color: transparent;
}

.table-responsive {
    overflow: visible !important;
}

.icon-visibility {
    user-select: none;
    transition: transform 0.2s ease;
    /* เพิ่ม 2 บรรทัดนี้ครับ */
    position: relative;
    top: 3px; /* ปรับค่านี้ (2px - 4px) จนกว่าจะดูตรงกลางตามสายตาคุณ */
    font-size: 32px !important;
    /* ให้แน่ใจว่าไอคอนไม่มี margin ล่างที่ดันตัวเองขึ้น */
    margin-bottom: 0; 
    display: inline-flex;
    align-items: center;
    
}

.icon-visibility:hover {
    transform: scale(1.2); /* ขยายขนาดเล็กน้อยเวลา hover */
}

</style>