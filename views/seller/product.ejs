<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management</title>
    <!-- Link Bootstrap -->
    <link rel="stylesheet" href="/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=visibility,visibility_off" />

    <!-- Link style.css -->
    <link rel="stylesheet" href="/styles/style.css" />
</head>
<body>
    <%-include('partials/navbar')%>
    <main class="container my-4">
    <h2 class="section-title">ADD PRODUCT</h2>
    <div class="section-container">
        <form action="/api/product/add" method="POST" enctype="multipart/form-data">
            <div class="row"> <div class="col-md-5 d-flex justify-content-start align-items-start mb-3">
                    <div class="card custom-upload-card text-center shadow-lg border-0 p-4 w-100" style="height: 400px;">
                        <button type="button" class="btn-close btn-close-white position-absolute end-0 top-0 m-3" aria-label="Close"></button>
                        <div class="card-body d-flex flex-column align-items-center justify-content-center">
                            <div class="icon-wrapper mb-3">
                                <i class="bi bi-image" style="font-size: 5rem; color: #ccc;"></i>
                            </div>
                            <p class="card-text text-white fw-light fs-5">Click to upload the poster</p>
                            <input type="file" class="d-none" id="posterUpload" name="image">
                        </div>
                    </div>
                </div>

                <div class="col-md-7">
                    <div class = "row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Name:</label>
                            <input type="text" class="form-control square-input" id="name" name="name" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="price" class="form-label">Price:</label>
                            <input type="number" step="0.01" class="form-control square-input" id="price" name="price" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category:</label>
                        <select class="form-select square-input" id="category" name="category" required>
                            <option value="" selected disabled>Select a category</option>
                            <option value="electronics">Electronics</option>
                            <option value="clothing">Clothing</option>
                            <option value="food">Food & Beverage</option>
                            <option value="others">Others</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description:</label>
                        <textarea class="form-control square-input" id="description" name="description" rows="3" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add Product</button>
                </div>

            </div> </form>
    </div>
</main>
</body>
</html>
<style>
    body {
    background-color: #8122C9;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
.section-container {
    background-color: #8B00F5;
    border-radius: 25px;
    padding: 25px;
    width: 100%;
    max-width: 1340px;
    margin: 0 auto 40px auto;
    overflow: visible !important;
    height: auto !important;
}
/* กำหนดสีพื้นหลังและลักษณะของ Card */
.custom-upload-card {
  background-color: #8a2be2; /* สีม่วงตามภาพ */
  width: 350px;
  height: 500px;
  border-radius: 25px; /* มุมโค้งมน */
  cursor: pointer;
  transition: transform 0.2s ease;
}

.custom-upload-card:hover {
  transform: scale(1.02); /* เอฟเฟกต์เวลาเอาเมาส์วาง */
}

/* ปรับแต่งส่วน Icon (หากใช้ภาพ Placeholder) */
.icon-wrapper {
  background-color: #f8f9fa;
  border-radius: 0 !important; /* ลบความโค้งมนออกทั้งหมด */
  padding: 30px;
  width: 80%;
}
.square-input {
    border-radius: 0 !important; /* ลบความโค้งมนออกทั้งหมด */
    border: 1px solid #ced4da; /* ปรับสีเส้นขอบตามต้องการ */
}
</style>