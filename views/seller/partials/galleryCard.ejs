<style>
    /* คุมขนาดภาพรวมไม่ให้ใหญ่เกิน 256px แต่ยืดหยุ่นตาม Grid ได้ */
.gallery-item-wrapper {
    max-width: 256px;
    margin: 0 auto; /* จัดกลางในคอลัมน์ตัวเองเมื่อจอเล็ก */
}

/* ปรับการ์ดให้เป็นสี่เหลี่ยมจตุรัสและยืดหยุ่น */
.gallery-card {
    width: 100% !important;
    aspect-ratio: 1 / 1; /* บังคับเป็นสี่เหลี่ยมจตุรัสเสมอโดยไม่ต้องระบุความสูง */
    background-color: rgba(255, 255, 255, 0.1) !important;
    border-radius: 20px !important;
}

/* ปรับแต่งส่วน Icon Wrapper ด้านใน */
.gallery-card .icon-wrapper {
    width: 80%;
    height: 50%; /* ปรับสัดส่วนตามความสูงของการ์ด */
    background-color: #f8f9fa;
    border-radius: 15px !important;
    display: flex;
    justify-content: center;
    align-items: center;
}

.gallery-placeholder-img {
    max-height: 80%;
    width: auto;
    object-fit: contain;
}

/* ปรับแต่ง Progress bar ให้กว้างเท่าการ์ดเสมอ */
.gallery-item-wrapper .progress {
    width: 100%;
}
.progress {
    background-color: rgba(255, 255, 255, 0.2) !important;
    border-radius: 10px !important;
}

.progress-bar {
    background-color: white !important; /* แถบ Progress สีขาว */
}
/* --- Video URL (Capsule Design) --- */
.video-input {
    border-radius: 50px !important; /* ทรงแคปซูลมน */
    border: none !important;
    padding: 10px 20px;
    background-color: white !important;
    color: #333;
    margin-bottom: 10px;
    max-height: 22px !important;
    max-width: 256px !important;

}
.gallery-placeholder-img {
    max-height: 120px;
    width: auto;
    transition: transform 0.2s;
}

.gallery-card:hover .gallery-placeholder-img {
    transform: scale(1.05);
}
</style>

<script>
    document.querySelectorAll('.gallery-item-wrapper').forEach(wrapper => {
        const card = wrapper.querySelector('.gallery-card');
        const input = wrapper.querySelector('input[type="file"]');
        const img = wrapper.querySelector('.gallery-placeholder-img');
        // เพิ่มบรรทัดนี้เพื่อหาแถบ progress
        const progress = wrapper.querySelector('.progress');
        const statusText = progress.querySelector('p');

        // 1. คลิกที่ Card แล้วเปิดหน้าต่างเลือกไฟล์
        card.addEventListener('click', function(e) {
            if (!e.target.classList.contains('btn-close')) {
                input.click();
            }
        });

        // 2. เมื่อเลือกไฟล์แล้ว ให้ Preview
        input.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    img.src = e.target.result;
                    // ปรับการแสดงผลรูปที่เลือกมาให้เต็มกรอบ
                    img.style.objectFit = 'cover';
                    img.style.width = '100%';
                    img.style.height = '100%';
                    img.parentElement.style.width = '100%'; // icon-wrapper
                    img.parentElement.style.height = '100%';
                    
                    statusText.textContent = input.files[0].name;
                    statusText.style.color = "#FFFFFF"; // เปลี่ยนสีข้อความเป็นขาวเมื่อมีไฟล์แล้ว
                    statusText.style.fontWeight = "1rem"; // ปรับขนาดข้อความให้เล็กลงเมื่อมีไฟล์แล้ว
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        // 3. ปุ่ม Close สำหรับล้างรูป
        const closeBtn = wrapper.querySelector('.btn-close');
        closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            input.value = "";
            img.src = "/picture.png";
            // รีเซ็ตสไตล์รูปภาพกลับเป็นค่าเริ่มต้น
            img.style.objectFit = 'contain';
            img.style.width = 'auto';
            img.style.height = 'auto';
            
            statusText.textContent = "Uploading...";
            statusText.style.color = "";
        });
    });
</script>