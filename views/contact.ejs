<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD5F - Contacts</title>
    <!-- Link Bootstrap -->
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css" />
    <link
      rel="stylesheet"
      href="/bootstrap-icons/font/bootstrap-icons.min.css"
    />
    <!-- Link style.css -->
    <link rel="stylesheet" href="/styles/style.css" />

    <!-- Link animations.css -->
    <link rel="stylesheet" href="/styles/animations.css" />

    <!-- Map stylesheet -->
    <link
      href="https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.css"
      rel="stylesheet"
    />

    <!-- Map API -->
    <script src="https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.js"></script>
  </head>
  <body>
    <%-include('buyer/partials/navbar')%>

    <main class="container my-4">
      <h1 class="fs-1 scroll-reveal">Contacts</h1>
      <a href="/" class="back-to-home scroll-reveal" style="--reveal-delay: 100ms"><p>< Back to Home</p></a>
      <div class="container-fluid contact-container rounded-4 p-5 scroll-reveal" style="--reveal-delay: 150ms">
        <div id="map" class="map-container w-100 rounded-4 mb-3"></div>
        <p id="address">
          <b>Address: </b> College of Arts, Media, and Technology, Chiang Mai
          University. <br />

          239 Huay Kaew Rd. Tambon Su Thep, Amphoe Mueang Chiang Mai 50200,
          Thailand. <br />
          Tel: 053-920299
        </p>
      </div>

      <div
        class="container-fluid contact-container d-inline-flex justify-content-evenly gap-2 p-4 my-3 rounded-4 scroll-reveal"
        style="--reveal-delay: 250ms"
      >
        <div class="text-center" id="contact-facebook">
          <a href="">
            <img class="mb-2" src="/assets/facebook.png" alt="" />
            <p>KaiDao5Fong</p>
          </a>
        </div>
        <div class="text-center" id="contact-ig">
          <a href="">
            <img class="mb-2" src="/assets/instagram.png" alt="" />
            <p>@KaiDao5Fong</p>
          </a>
        </div>
        <div class="text-center" id="contact-mail">
          <a href="">
            <img class="mb-2" src="/assets/message.png" alt="" />
            <p>admin@kd5f.com</p>
          </a>
        </div>
      </div>
    </main>

    <%-include('buyer/partials/footer')%>

    <script src="/scripts/scroll-reveal.js"></script>
    <script type="module" src="/scripts/contact.js"></script>
  </body>
  <style>
    #address {
      font-size: 24px;
      text-align: justify;
    }

    .contact-container {
      background-color: #8b00f5;
    }

    .contact-container > div > p {
      line-height: 1;
    }

    .contact-container img {
      max-width: 64px;
      max-height: 64px;
    }

    .map-container {
      max-height: 720px;
      max-width: 1280px;
      width: 1280px;
      height: 720px;
    }

    a {
      color: #fefefe;
    }
  </style>
</html>
