<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register</title>

    <link rel="stylesheet" href="/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/styles/style.css" />
    <link rel="stylesheet" href="/styles/signPage.css" />
  </head>
  <body>
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
          <div>
            <h1 class="sign">Sign up</h1>
          </div>
          <div class="contentBox rounded-4 p-3 mt-5">
            <a href="/" class="hyperlink"
              ><i class="bi bi-caret-left"></i> Back to Home</a
            >
            <div class="identification">
              <i class="bi bi-person-fill-add"></i>
              <!-- User Registration field -->
              <div class="form-group">
                <label for="username">Username:</label>
                <input
                  name="username"
                  type="text"
                  class="form-control rounded-4 mt-1 my-2"
                  placeholder="Username"
                />

                <label for="password">
                  Password:
                  <i class="bi bi-info-circle" style="color: #2f2b33"></i>
                </label>
                <div class="input-with-icon">
                  <input
                    name="password"
                    type="password"
                    class="form-control rounded-4 mt-1 my-2"
                    placeholder="password"
                  />
                  <i class="bi bi-eye input-icon"></i>
                </div>

                <label for="confirm-pasword">Confirm Password:</label>
                <div class="input-with-icon">
                  <input
                    name="confirm-pasword"
                    type="password"
                    class="form-control rounded-4 mt-1 my-2"
                    placeholder="Confirm Password"
                  />
                  <i class="bi bi-eye input-icon"></i>
                </div>
              </div>

              <p class="text-center py-2">
                Already have an account?
                <a href="/login" style="color: #b7ef00">Sign in here</a>
              </p>
              <!-- button to buyer and seller page -->
              <div class="buttons">
                <a href="#"
                  ><button class="btn sign-btn rounded-4">Sign up</button></a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
  <script src="/dist/js/bootstrap.bundle.min.js"></script>
</html>
